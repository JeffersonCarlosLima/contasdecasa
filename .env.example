# Banco PostgreSQL existente (um único banco, schema public)
DATABASE_URL=postgres://usuario:senha@host:5432/financas

# Better Auth: gere com `openssl rand -base64 32`
BETTER_AUTH_SECRET=troque-por-um-segredo-longo
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Porta do host (só em 127.0.0.1) usada pelo compose.yaml
APP_PORT=3000

# SMTP (opcional). Sem isto, o link de convite é exibido na tela para copiar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Contas da Casa <no-reply@exemplo.com>"
